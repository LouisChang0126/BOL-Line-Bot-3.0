# ── Firebase Web 設定 ───────────────────────────────────────────────
# 這些是「公開」設定值（不是密鑰）。安全性由 Firestore Security Rules + App Check 把關。
# 若留空，src/firebase/config.ts 會 fallback 到內建的 bol-line-bot-3 專案預設值。
# 換專案時才需要在 .env 覆寫。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 site key（Firebase App Check）
VITE_RECAPTCHA_SITE_KEY=

# AI 排班 Cloud Function URL
VITE_AGENT_API_URL=

# 本機開發時把 App Check 關掉（避免 reCAPTCHA 網域限制擋住 localhost）
# 正式環境請勿設定或設為 false
VITE_DISABLE_APP_CHECK=true
